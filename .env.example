# Server only. Copy to ignored .env.local for local development.
# Use the pooled connection URL from Neon. Remote TLS certificates are verified.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=verify-full
# Neon CLI also pulls this direct URL; migrations prefer it over DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=verify-full
# Keep tcp on Vercel. Use websocket in HTTPS-proxy-only cloud workspaces.
DATABASE_TRANSPORT=tcp
APP_URL=http://localhost:5173
RESEND_API_KEY=
MAIL_FROM=School Hub <accounts@your-verified-domain.example>
GOOGLE_CLIENT_ID=930878075584-tla117755do4gak6s9qqec5agdmqv6kk.apps.googleusercontent.com

# Public build-time settings. Never put database URLs or secrets in VITE_* variables.
VITE_GOOGLE_CLIENT_ID=930878075584-tla117755do4gak6s9qqec5agdmqv6kk.apps.googleusercontent.com
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xgaawjzg
